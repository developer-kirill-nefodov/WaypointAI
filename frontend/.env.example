# Override with an approved tile provider or set empty to hide the online basemap.
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional API origin. Leave unset to use the current origin (Vite proxies /api in development).
# VITE_API_BASE=http://127.0.0.1:8000
# Optional WebSocket URL. By default it follows VITE_API_BASE/current origin and uses ws/wss automatically.
# VITE_WS_URL=ws://127.0.0.1:8000/api/v1/assistant/ws
