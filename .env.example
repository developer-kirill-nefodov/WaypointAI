NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://waypoint:waypoint_dev@127.0.0.1:5433/waypoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_NUM_CONTEXT=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_NUM_BATCH=256
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=60s
# Optional Vulkan GPU offload for `npm run model:serve`. Set both to 1 for integrated GPUs such as Intel Arc.
OLLAMA_VULKAN=0
OLLAMA_IGPU_ENABLE=0
# OSRM-compatible routing service. The public demo endpoint is for development; production should self-host OSRM.
ROUTING_BASE_URL=https://router.project-osrm.org
DEMO_MODE=true
# Demo, opt-in voice input. When enabled, the backend relays microphone audio to OpenAI Realtime
# transcription; audio leaves the local machine. The key stays on the backend and is never sent to the browser.
VOICE_INPUT_ENABLED=false
OPENAI_API_KEY=
# Only wss://api.openai.com is allowlisted.
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
VOICE_MAX_SESSION_SECONDS=120
VOICE_CONNECT_TIMEOUT_MS=10000
# Spending limits: open sessions process-wide; sessions and reserved recording seconds per client address per hour.
VOICE_MAX_CONCURRENT_SESSIONS=4
VOICE_SESSIONS_PER_CLIENT_PER_HOUR=20
VOICE_SECONDS_PER_CLIENT_PER_HOUR=900
# Investigation events (demo). Imports run manually: `npm run data:import:events -- --source ingv-fdsn --days 7`.
# Only allowlisted hosts are accepted for the source URL. INGV data is CC BY 4.0; keep the attribution visible.
EVENT_SOURCE_INGV_URL=https://webservices.ingv.it/fdsnws/event/1/query
# minLon,minLat,maxLon,maxLat of the import area.
EVENT_IMPORT_BBOX=6,35,19,48
EVENT_IMPORT_COOLDOWN_SECONDS=600
EVENT_IMPORT_TIMEOUT_MS=20000
# The HTTP import trigger has no authentication; keep it disabled outside a local demo.
INVESTIGATION_IMPORT_ENABLED=false
# Express "trust proxy": false for direct connections, or the number of reverse-proxy hops in front of the API.
# Rate limits are per client IP; never trust X-Forwarded-For from arbitrary clients.
TRUST_PROXY=false
